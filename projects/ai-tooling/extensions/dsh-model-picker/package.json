{
  "name": "@local/dsh-model-picker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Classified model picker for the DSH composer: channel → model family → model, with reasoning efforts folded into a third level.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
