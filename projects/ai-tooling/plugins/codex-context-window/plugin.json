{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-context-window",
  "version": "0.1.0",
  "description": "本机上下文窗口滑动条：256k 到 1024k，默认 512k，保存前自动备份配置。",
  "author": {
    "name": "Local Tools"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "上下文窗口",
        "shortDescription": "滑动调整 Codex 上下文窗口",
        "longDescription": "本机上下文窗口滑动条：256k 到 1024k，默认 512k，保存前自动备份配置。",
        "developerName": "Local Tools",
        "category": "Productivity",
        "capabilities": [
          "Interactive"
        ],
        "defaultPrompt": "打开上下文窗口滑动条。",
        "logo": "./assets/icon.svg",
        "composerIcon": "./assets/icon.svg"
      },
      "requires_local_executor": true
    }
  }
}
