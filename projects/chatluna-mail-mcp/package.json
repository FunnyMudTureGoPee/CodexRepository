{
  "name": "koishi-plugin-chatluna-mail-mcp",
  "version": "0.7.1",
  "description": "Local ChatLuna context-aware scheduled mail MCP for Koishi",
  "type": "module",
  "main": "lib/index.cjs",
  "types": "lib/index.d.cts",
  "files": [
    "lib",
    "README.md",
    "docs",
    "examples",
    "scripts",
    "console",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "tsc -p tsconfig.test.json && node --test test-build/tests/*.test.js",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "nodemailer": "^10.1.7",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.11",
    "@koishijs/plugin-server": "^3.2.3",
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": ">=1.4.0-alpha.44 <1.5.0"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-chatluna": {
      "optional": true
    },
    "@koishijs/plugin-console": {
      "optional": true
    }
  },
  "devDependencies": {
    "@koishijs/client": "5.30.11",
    "@koishijs/plugin-console": "5.30.11",
    "@koishijs/plugin-database-memory": "^3.7.0",
    "@koishijs/plugin-database-sqlite": "4.7.0",
    "@koishijs/plugin-server": "^3.2.3",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^7.0.0",
    "@types/smtp-server": "^3.5.12",
    "koishi": "^4.18.9",
    "smtp-server": "^3.16.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vue": "3.5.22"
  },
  "koishi": {
    "description": {
      "zh": "基于 ChatLuna 预设及会话上下文判断的定时图文邮件 MCP"
    },
    "service": {
      "required": [
        "database",
        "server"
      ],
      "optional": [
        "chatluna",
        "console",
        "mediaLuna"
      ]
    }
  }
}